# ======================================================
# Local overrides — general Python/Node/OS rules are
# defined in the root .gitignore and apply recursively
# ======================================================

# Virtual environments
myenvv/
rag_env/

# Environment files
.env
.env.*
!.env.example

# Node dependencies
node_modules/

# Visual Studio Code (keep shared settings)
.vscode/*
!.vscode/settings.json
